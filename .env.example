# Database
DATABASE_URL=postgresql://trackclear:localdev@localhost:5433/trackclear
# Direct URL for Prisma Migrate (bypasses connection pooler like PgBouncer)
# In production with a pooler, set this to the direct DB connection
DIRECT_DATABASE_URL=postgresql://trackclear:localdev@localhost:5433/trackclear

# Redis
REDIS_URL=redis://localhost:6379

# Auth (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (from Stripe Dashboard > Products)
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_SCALE_PRICE_ID=price_xxx

# Meta
META_API_VERSION=v21.0

# Security
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DNS target shown in Settings for merchant-owned custom ingest domains.
# For Vercel subdomain CNAMEs this is usually cname.vercel-dns.com.
NEXT_PUBLIC_CUSTOM_INGEST_CNAME_TARGET=cname.vercel-dns.com

# Comma-separated workspace IDs that must always run in legacy/headless mode.
# Use this as an emergency bypass for protected custom/headless stores.
LEGACY_WORKSPACE_IDS=

# Production release gate. Configure the Railway production environment ID on
# Railway and set the exact 40-character approved commit SHA on both Railway and
# Vercel during a controlled release. Keep the SHA pinned for that deployment's
# full lifetime and rotate it atomically at the next cutover; unset or mismatched
# values fail closed.
TRACKCLEAR_PRODUCTION_RAILWAY_ENVIRONMENT_ID=
TRACKCLEAR_PRODUCTION_RELEASE_SHA=
# Pin the intended production PostgreSQL target. Populate these from a verified
# read-only query during cutover; the system identifier is numeric and is not a
# credential. A physical clone can retain it, so provider URL checks still apply.
TRACKCLEAR_PRODUCTION_DATABASE_NAME=
TRACKCLEAR_PRODUCTION_DATABASE_SCHEMA=public
TRACKCLEAR_PRODUCTION_DATABASE_SYSTEM_IDENTIFIER=

# Ingest URL used in JS snippet (REQUIRED for local dev)
# Without this, the snippet API route defaults to https://www.trackclear.io/api/events/ingest
NEXT_PUBLIC_INGEST_URL=http://localhost:3000/api/events/ingest

# Admin (optional - comma-separated list of admin email addresses)
ADMIN_EMAILS=

# Sentry (optional - error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
