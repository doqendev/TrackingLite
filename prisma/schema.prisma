generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================
// AUTH (managed by NextAuth.js v5)
// ============================================================

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  hashedPassword      String?              // null if signed up via Google OAuth
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  sessions            Session[]
  workspaces          Workspace[]
  subscription        Subscription?
  passwordResetTokens PasswordResetToken[]
  alertPreference     AlertPreference?
  displayCurrency     String               @default("USD")
  language            String               @default("en")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

// ============================================================
// CORE BUSINESS
// ============================================================

model Workspace {
  id                        String          @id @default(cuid())
  userId                    String
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                      String          // e.g., "My Shopify Store"
  domain                    String?         // e.g., "mystore.myshopify.com" (optional, for display)
  platform                  Platform        @default(SHOPIFY)
  apiKey                    String          @unique // Unique API key for this workspace (used in JS snippet)
  metaPixelId               String?         // Meta Pixel ID
  metaAccessTokenEncrypted  String?         // AES-256-GCM encrypted
  metaAccessTokenIv         String?         // IV for decryption
  metaAccessTokenTag        String?         // Auth tag for decryption
  metaTestEventCode         String?         // For testing in Meta Events Manager
  enableMeta                Boolean   @default(true)

  // TikTok fields
  tiktokPixelId               String?
  tiktokAccessTokenEncrypted  String?
  tiktokAccessTokenIv         String?
  tiktokAccessTokenTag        String?
  enableTikTok                Boolean   @default(false)

  // GA4 fields
  ga4MeasurementId            String?
  ga4ApiSecretEncrypted       String?
  ga4ApiSecretIv              String?
  ga4ApiSecretTag             String?
  enableGA4                   Boolean   @default(false)

  // Klaviyo fields
  klaviyoApiKeyEncrypted      String?
  klaviyoApiKeyIv             String?
  klaviyoApiKeyTag            String?
  enableKlaviyo               Boolean   @default(false)

  // Reddit fields
  redditAccountId                 String?
  redditAccessTokenEncrypted      String?
  redditAccessTokenIv             String?
  redditAccessTokenTag            String?
  enableReddit                    Boolean   @default(false)

  // Pinterest fields
  pinterestAdAccountId                  String?
  pinterestConversionTokenEncrypted     String?
  pinterestConversionTokenIv            String?
  pinterestConversionTokenTag           String?
  enablePinterest                       Boolean   @default(false)

  // Shopify webhook fields
  shopifyWebhookSecretEncrypted String?   // AES-256-GCM encrypted
  shopifyWebhookSecretIv        String?   // IV for decryption
  shopifyWebhookSecretTag       String?   // Auth tag for decryption
  shopifyDomain         String?   // e.g., "mystore.myshopify.com"

  consentMode               ConsentMode     @default(STRICT)
  isActive                  Boolean         @default(true)
  enablePageView            Boolean         @default(true)
  enableViewContent         Boolean         @default(true)
  enableAddToCart           Boolean         @default(true)
  enableInitiateCheckout    Boolean         @default(true)
  enablePurchase            Boolean         @default(true)
  eventsForwardedCount      Int             @default(0)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  events                    EventLog[]

  @@index([userId])
  @@index([apiKey])
  @@index([shopifyDomain])
}

model EventLog {
  id             String      @id @default(cuid())
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventName      EventName
  eventId        String      // dedup event_id (UUID from JS snippet)
  status         EventStatus @default(PENDING)
  metaResponse   Json?       // Raw Meta CAPI response
  errorMessage   String?
  retryCount     Int         @default(0)
  payload        Json?       // Sanitized payload (no raw PII)
  customerIp     String?
  userAgent      String?
  fbp            String?     // _fbp cookie value
  fbc            String?     // _fbc cookie value
  pageUrl        String?     // URL where event occurred
  value          Float?      // monetary value (e.g., cart total, purchase amount)
  currency       String?     // ISO 4217 currency code (e.g., "USD", "BRL")
  numItems       Int?        // number of items in cart/order
  orderId        String?     // Shopify order ID (for dedup)
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  gclid          String?
  ttclid         String?
  rdtCid         String?
  epik           String?
  refundId       String?
  refundAmount   Float?
  destination    Destination  @default(META)
  source         String?     @default("snippet")  // "snippet" | "webhook"
  paymentGateway String?     // e.g. "paypal", "shopify_payments", "klarna" (webhook only)
  createdAt      DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, eventName])
  @@index([workspaceId, destination])
  @@index([workspaceId, utmSource, utmCampaign])
  @@index([eventId])
  @@unique([workspaceId, eventId, destination])
  @@index([status, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, eventName, destination, createdAt])
  @@index([workspaceId, refundId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 BillingPlan        @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model AlertPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Alert types - which alerts are enabled
  trackingDown      Boolean @default(true)   // success rate < 80%
  highErrorRate     Boolean @default(true)   // >10% errors in last hour
  orderLimitWarning Boolean @default(true)   // 80% and 95% of monthly limit
  orderLimitReached Boolean @default(true)   // 100% of limit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model AlertLog {
  id        String   @id @default(cuid())
  userId    String
  alertType String   // "tracking_down", "high_error_rate", "order_limit_warning", "order_limit_reached"
  message   String
  sentAt    DateTime @default(now())

  @@index([userId, alertType, sentAt])
}

model WebhookDeadLetter {
  id         String    @id @default(cuid())
  topic      String
  shopDomain String
  payload    String    @db.Text
  headers    String?   @db.Text
  error      String    @db.Text
  requestId  String?
  createdAt  DateTime  @default(now())
  retries    Int       @default(0)
  resolvedAt DateTime?

  @@index([shopDomain])
  @@index([createdAt])
  @@index([resolvedAt])
}

// ============================================================
// ENUMS
// ============================================================

enum Platform {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  CUSTOM
}

enum EventName {
  PageView
  ViewContent
  AddToCart
  InitiateCheckout
  Purchase
  Refund
}

enum EventStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum ConsentMode {
  STRICT
  LAX
}

enum BillingPlan {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum Destination {
  META
  TIKTOK
  GA4
  KLAVIYO
  REDDIT
  PINTEREST
}
