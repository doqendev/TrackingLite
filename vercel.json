  "framework": "nextjs",
  "buildCommand": "pnpm build:vercel",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "src/app/api/events/ingest/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/stripe/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/shopify/route.ts": {
      "maxDuration": 30
    }
  }
}
